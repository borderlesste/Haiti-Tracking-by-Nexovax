# Local development only. Copy to .env (ignored); never use these placeholders in production.
APP_ENV=development
WEB_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
# Set only the actual TLS proxy IPs/CIDRs in production. Never trust arbitrary forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
# SQLite is only for the local quick start. Docker uses its dedicated PostGIS database.
DATABASE_URL=sqlite:///./.runtime/haiti-tracking.db
DATABASE_AUTO_CREATE=true
# Production migration only: existing nonowner LOGIN role receiving explicit backend RLS policies.
BACKEND_DB_ROLE=
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ALPHANUMERIC_PASSWORD
SESSION_SECRET=CHANGE_ME_USE_32_OR_MORE_RANDOM_CHARACTERS
API_KEY_PEPPER=CHANGE_ME_USE_DIFFERENT_RANDOM_CHARACTERS
# Empty Resend key selects local development outbox; no real email is sent.
RESEND_API_KEY=
EMAIL_FROM=Haiti Tracking <onboarding@resend.dev>
EVIDENCE_DIR=./.runtime/private-evidence
RUNTIME_DIR=./.runtime
# Private S3-compatible storage is required for production evidence.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
REWARDS_CASH_ENABLED=false
